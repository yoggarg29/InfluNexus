# Copy this file to .env and fill in your own local values.
# .env is in .gitignore and should NEVER be committed.

PORT=2001

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=influnexus

# Any long random string. Used to sign the session cookie.
SESSION_SECRET=change_this_to_a_long_random_string
